# AI Hub — biến môi trường dùng chung, dạng KEY=VALUE thuần.
#
# File này là nguồn duy nhất; aihub.ps1 / aihub.cmd / aihub.sh đều đọc lại từ đây,
# và `aihub env` in ra chính nó. Giá trị KHÔNG bọc nháy — mọi thứ sau dấu = đầu
# tiên là giá trị, kể cả khi có dấu cách.
#
# TUYỆT ĐỐI KHÔNG để API key / token ở đây. `aihub doctor` lint điều này.

AIHUB_HOME=E:\AI Hub
AIHUB_STORE=E:\AI Hub\models

# ── Vị trí kho ───────────────────────────────────────────────────────────────
OLLAMA_MODELS=E:\AI Hub\models\ollama
HF_HOME=E:\AI Hub\models\hf
TORCH_HOME=E:\AI Hub\models\torch
AIHUB_WHISPER_DIR=E:\AI Hub\models\whisper
AIHUB_CT2_DIR=E:\AI Hub\models\ct2
AIHUB_CUSTOM_DIR=E:\AI Hub\models\custom
AIHUB_CT2_WHISPER=E:\AI Hub\models\links\faster-whisper-large-v3

# KHÔNG đặt HF_HUB_CACHE (sẽ bỏ lại xet/ ở chỗ cũ)
# KHÔNG đặt TRANSFORMERS_CACHE (đã deprecated)
# KHÔNG đặt XDG_CACHE_HOME (kéo theo pip/uv/npm — phạm vi quá rộng)

# ── Endpoint ─────────────────────────────────────────────────────────────────
AIHUB_OLLAMA_URL=http://127.0.0.1:11434

# ── Điều phối bộ nhớ: 32 GB RAM, GTX 1060 6 GB VRAM ──────────────────────────
# Ràng buộc thật ở đây là VRAM chứ không phải RAM. Một model 9B Q4 (~6,6 GB) đã
# vượt 6 GB VRAM và phải đẩy bớt layer sang CPU; nạp hai model cùng lúc thì cả
# hai đều rơi xuống CPU. Vì vậy vẫn giữ 1 dù RAM rộng gấp đôi máy Mac gốc.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_QUEUED=8
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
