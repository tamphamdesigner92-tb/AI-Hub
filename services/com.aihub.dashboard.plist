<?xml version="1.0" encoding="UTF-8"?>
<!-- Giữ dashboard AI Hub luôn chạy, để gõ thẳng URL vào trình duyệt là vào được.
     Rất nhẹ: server stdlib Python, ~20 MB RAM, không nạp model nào.
     Bật:  launchctl load -w ~/Library/LaunchAgents/com.aihub.dashboard.plist
     Tắt:  launchctl unload -w ~/Library/LaunchAgents/com.aihub.dashboard.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aihub.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mac/.aihub/.venv/bin/python</string>
    <string>/Users/mac/.aihub/web/server.py</string>
    <string>7860</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>AIHUB_HOME</key><string>/Users/mac/.aihub</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/mac/.aihub/models/run/web.log</string>
  <key>StandardErrorPath</key><string>/Users/mac/.aihub/models/run/web.log</string>
</dict>
</plist>
