#!/bin/sh
# Mở dashboard AI Hub (POSIX). Tự bật server nếu chưa chạy.
# Trên Windows dùng bin\aihubdashboard.cmd.
if [ -z "$AIHUB_HOME" ]; then
  AIHUB_HOME="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
fi
PORT="${AIHUB_WEB_PORT:-7860}"
URL="http://127.0.0.1:$PORT"

PY="$AIHUB_HOME/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"

if ! curl -sf -m 2 "$URL/api/status" >/dev/null 2>&1; then
  echo "Đang bật dashboard…"
  mkdir -p "$AIHUB_HOME/models/run"
  AIHUB_HOME="$AIHUB_HOME" nohup "$PY" "$AIHUB_HOME/web/server.py" "$PORT" --no-open \
      >> "$AIHUB_HOME/models/run/web.log" 2>&1 &
  i=0
  while [ $i -lt 15 ]; do
    sleep 0.4
    curl -sf -m 2 "$URL/api/status" >/dev/null 2>&1 && break
    i=$((i + 1))
  done
fi

if ! curl -sf -m 2 "$URL/api/status" >/dev/null 2>&1; then
  echo "Server không lên được. Xem log: $AIHUB_HOME/models/run/web.log" >&2
  exit 1
fi

echo "$URL"
# open (macOS) → xdg-open (Linux) → start (Git Bash trên Windows)
command -v open >/dev/null 2>&1 && exec open "$URL"
command -v xdg-open >/dev/null 2>&1 && exec xdg-open "$URL"
command -v start >/dev/null 2>&1 && exec start "$URL"
